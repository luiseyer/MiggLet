{
  "name": "migglet",
  "private": true,
  "version": "0.9.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "pocketbase": "cd pocketbase && pocketbase serve",
    "dev": "concurrently \"vite\" \"npm:pocketbase\"",
    "preview": "concurrently \"vite preview\" \"npm:pocketbase\""
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.0",
    "@mui/icons-material": "6.4.8",
    "@mui/material": "6.4.8",
    "@tanstack/react-query": "5.69.0",
    "@tiptap/pm": "2.11.5",
    "@tiptap/react": "2.11.5",
    "@tiptap/starter-kit": "2.11.5",
    "html-to-md": "0.8.6",
    "marked": "15.0.7",
    "pocketbase": "0.25.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router-dom": "7.4.0"
  },
  "devDependencies": {
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "standard": "17.1.2",
    "vite": "6.2.2",
    "vite-plugin-pwa": "0.21.2"
  },
  "eslintConfig": {
    "plugins": [
      "react-hooks"
